# Copiá este archivo como .env (o .env.local) y ajustá los valores.
#   cp .env.example .env

# URL de la API en producción (en desarrollo se usa el proxy de Vite y
# no hace falta configurar nada). Si queda vacío en producción, el sitio
# funciona igual con el contenido de respaldo (content/catalogo.seed.json).
VITE_API_URL=

# WhatsApp de la marca SOLO con dígitos, con código de país y sin '+'.
# Si está vacío o inválido, el botón de WhatsApp no se muestra.
# Ejemplo: 5491122334455
VITE_WHATSAPP_NUMBER=

# Correo de contacto. Si está vacío o inválido, el botón de correo no se muestra.
VITE_CONTACT_EMAIL=
