# Copiá este archivo como .env y ajustá los valores.
#   cp .env.example .env

# --- Base de datos ---
# Desarrollo local sin MySQL (SQLite):
DATABASE_URL=sqlite:///./koneki.db
# Producción / Docker (MySQL):
# DATABASE_URL=mysql+pymysql://koneki:koneki_secreta@127.0.0.1:3306/koneki_lab?charset=utf8mb4

# Orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Entorno y app
ENTORNO=desarrollo
APP_NAME="Koneki X Lab API"

# Límite de solicitudes por IP (por ventana)
RATE_LIMIT_SOLICITUDES=5
RATE_LIMIT_VENTANA_SEG=3600

# Carga automática del seed al arrancar si las tablas están vacías (true/false)
SEED_AUTOMATICO=true

# --- SMTP opcional ---
# Si SMTP_HOST está vacío, no se envía ningún correo (el formulario igual guarda la solicitud).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_TLS=true
